# Build artifacts — everything here is generated by `make` and must never
# be committed. Compiled binaries are machine-specific and would otherwise
# be re-added by anyone who builds the curriculum.

# object files, libraries, dependency files
*.o
*.a
*.so
*.d

# the top-level Makefile's output directory
build/

# per-project build directories and binaries
*/practice/*/build/
16-Machine-Learning-in-C/*/build/

# named executables produced by the sub-project Makefiles
06-Structs-Unions-Enums/practice/04_opaque_type/stackdemo
08-Modular-Programming-and-Build-Systems/practice/mathlib/mathdemo*
08-Modular-Programming-and-Build-Systems/practice/mathlib/test_mathlib
16-Machine-Learning-in-C/01-linear-regression/linreg
16-Machine-Learning-in-C/02-logistic-regression/logreg
16-Machine-Learning-in-C/05-neural-network/nn
16-Machine-Learning-in-C/06-autodiff/autodiff

# temporary files the demo programs create and delete themselves
07_text_io_demo.txt
07_binary_*.bin
07_csv_demo.csv
